    "# ============================================================================\n",
    "# 🚀 AUDIO SPLITTER + AUTO-UPLOAD VIA SFTP\n",
    "# ============================================================================\n",
    "import pysrt\n",
    "import subprocess\n",
    "import os\n",
    "import re\n",
    "import paramiko\n",
    "from google.colab import files, userdata\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 🔐 SFTP CONFIGURATION (PASSWORD FROM COLAB SECRETS)\n",
    "# ----------------------------------------------------------------------------\n",
    "SFTP_HOST   = \"lepka-iz-plastilina.ru.net\"\n",
    "SFTP_PORT   = 22\n",
    "SFTP_USER   = \"root\"\n",
    "SFTP_PASS   = userdata.get('SFTP_PASS')\n",
    "REMOTE_PATH = \"/var/www/lepka-iz-plastilina.ru/public_html/ii/audio/\"\n",
    "LOCAL_DIR   = \"chunks\"\n",
    "\n",
    "MAX_DURATION    = 30.0\n",
    "ALLOW_OVERSHOOT = True\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 🔧 HELPERS\n",
    "# ----------------------------------------------------------------------------\n",
    "def upload_to_site(local_file, remote_path=REMOTE_PATH):\n",
    "    try:\n",
    "        transport = paramiko.Transport((SFTP_HOST, SFTP_PORT))\n",
    "        transport.connect(username=SFTP_USER, password=SFTP_PASS)\n",
    "        sftp = paramiko.SFTPClient.from_transport(transport)\n",
    "        try:\n",
    "            sftp.stat(remote_path)\n",
    "        except IOError:\n",
    "            sftp.mkdir(remote_path)\n",
    "        remote_file = remote_path.rstrip(\"/\") + \"/\" + os.path.basename(local_file)\n",
    "        sftp.put(local_file, remote_file)\n",
    "        \n",
    "        # Делаем файл доступным для удаления через PHP на сайте\n",
    "        try:\n",
    "            sftp.chmod(remote_file, 0o666)\n",
    "        except Exception:\n",
    "            pass\n",
    "            \n",
    "        sftp.close()\n",
    "        transport.close()\n",
    "        return f\"✅ Uploaded: {remote_file}\"\n",
    "    except Exception as e:\n",
    "        return f\"❌ Upload error for {local_file}: {e}\"\n",
    "\n",
    "def export_chunk(audio_file, start_ms, end_ms, idx, out_dir=LOCAL_DIR):\n",
    "    start_sec = start_ms / 1000.0\n",
    "    end_sec   = end_ms   / 1000.0\n",
    "    output_name = os.path.join(out_dir, f\"{idx}.wav\")\n",
    "    cmd = [\"ffmpeg\", \"-y\", \"-i\", audio_file,\n",
    "           \"-ss\", str(start_sec), \"-to\", str(end_sec), output_name]\n",
    "    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "    return output_name, start_sec, end_sec\n",
    "\n",
    "def build_groups(srt_file):\n",
    "    subs = pysrt.open(srt_file)\n",
    "    groups, cur_start, cur_end = [], None, None\n",
    "    for sub in subs:\n",
    "        s_start, s_end = sub.start.ordinal, sub.end.ordinal\n",
    "        dur = (s_end - s_start) / 1000.0\n",
    "\n",
    "        if dur > MAX_DURATION:\n",
    "            if cur_start is not None:\n",
    "                groups.append((cur_start, cur_end)); cur_start = cur_end = None\n",
    "            if ALLOW_OVERSHOOT:\n",
    "                groups.append((s_start, s_end))\n",
    "            else:\n",
    "                t = s_start\n",
    "                while t < s_end:\n",
    "                    t2 = min(t + int(MAX_DURATION * 1000), s_end)\n",
    "                    groups.append((t, t2)); t = t2\n",
    "            continue\n",
    "\n",
    "        if cur_start is None:\n",
    "            cur_start, cur_end = s_start, s_end\n",
    "        else:\n",
    "            if (s_end - cur_start) / 1000.0 <= MAX_DURATION:\n",
    "                cur_end = s_end\n",
    "            else:\n",
    "                groups.append((cur_start, cur_end))\n",
    "                cur_start, cur_end = s_start, s_end\n",
    "\n",
    "    if cur_start is not None:\n",
    "        groups.append((cur_start, cur_end))\n",
    "    return groups\n",
    "\n",
    "# ----------------------------------------------------------------------------\n",
    "# 🚀 MAIN PIPELINE\n",
    "# ----------------------------------------------------------------------------\n",
    "print(\"📥 Выберите аудиофайл для загрузки...\")\n",
    "uploaded_files = files.upload()\n",
    "\n",
    "if not uploaded_files:\n",
    "    print(\"❌ Файл не выбран.\")\n",
    "else:\n",
    "    fname = list(uploaded_files.keys())[0]\n",
    "    print(f\"✅ Файл загружен: {fname}\")\n",
    "    \n",
    "    base = os.path.splitext(fname)[0]\n",
    "    srt_file = base + \".srt\"\n",
    "\n",
    "    # 1. Whisper → SRT\n",
    "    print(f\"\\n🎙️ Запуск Whisper (модель: small, язык: en)...\")\n",
    "    cmd = [\"whisper\", fname, \"--model\", \"small\", \"--output_format\", \"srt\", \"--language\", \"en\"]\n",
    "    subprocess.run(cmd, check=True)\n",
    "    \n",
    "    if not os.path.exists(srt_file):\n",
    "        raise FileNotFoundError(f\"SRT не создан: {srt_file}\")\n",
    "    print(f\"✅ Субтитры созданы: {srt_file}\")\n",
    "\n",
    "    # 2. Нарезка и загрузка\n",
    "    print(\"\\n✂️ Нарезка аудио по фразам...\")\n",
    "    groups = build_groups(srt_file)\n",
    "    print(f\"🧩 Кусков к созданию: {len(groups)}\\n\")\n",
    "\n",
    "    os.makedirs(LOCAL_DIR, exist_ok=True)\n",
    "    uploaded_chunks = []\n",
    "    \n",
    "    for i, (a, b) in enumerate(groups, start=1):\n",
    "        path, s, e = export_chunk(fname, a, b, i)\n",
    "        print(f\"[{i}] {os.path.basename(path)}  {s:.2f}s–{e:.2f}s  ({e-s:.2f}s)\")\n",
    "        \n",
    "        res = upload_to_site(path)\n",
    "        print(\"   \", res)\n",
    "        \n",
    "        if res.startswith(\"✅\"):\n",
    "            uploaded_chunks.append(os.path.basename(path))\n",
    "\n",
    "    # 3. Итог\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(f\"🎉 Готово. Кусков: {len(groups)}, загружено: {len(uploaded_chunks)}\")\n",
    "    print(f\"📁 https://lepka-iz-plastilina.ru.net/ii/audio/\")\n",
    "    for name in uploaded_chunks:\n",
    "        print(f\"  • https://lepka-iz-plastilina.ru.net/ii/audio/{name}\")\n",
    "    print(\"=\" * 60)"
   ]
  }
