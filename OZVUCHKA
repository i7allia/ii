    "# @title 🎙️ ЯЧЕЙКА 2: 4 эмоции (SEED=7, angry разбит) + Whisper { vertical-output: true }\n",
    "\n",
    "# ============================================================\n",
    "# 1. 4 ЭМОЦИИ\n",
    "# ============================================================\n",
    "emotion_blocks = [\n",
    "    {\n",
    "        \"emotion\": \"neutral\",\n",
    "        \"sentences\": [\n",
    "            \"Well, the 49ers are already there. They left on Wednesday to fly to Melbourne, about a 16 to 17-hour flight.\",\n",
    "            \"And they'll be there all week, and hopefully, from their perspective, they'll get used to the 17-hour time difference.\",\n",
    "        ],\n",
    "    },\n",
    "    {\n",
    "        \"emotion\": \"hype\",\n",
    "        \"sentences\": [\n",
    "            \"Look at this incredible play! He breaks through the entire defense and scores an unbelievable touchdown!\",\n",
    "            \"This is the fastest offense in the entire league, and nobody can stop them right now!\",\n",
    "        ],\n",
    "    },\n",
    "    {\n",
    "        \"emotion\": \"angry\",\n",
    "        \"sentences\": [\n",
    "            \"Are you kidding me right now?!\",\n",
    "            \"How can the coaching staff make such a terrible decision in the final quarter?!\",\n",
    "            \"This is absolute nonsense! The referee clearly missed the most obvious foul!\",\n",
    "            \"This is the most obvious foul of the entire game!\",\n",
    "        ],\n",
    "    },\n",
    "    {\n",
    "        \"emotion\": \"drama\",\n",
    "        \"sentences\": [\n",
    "            \"Everything was on the line. One second of hesitation, and the entire season would slip away.\",\n",
    "            \"And everyone in that stadium felt the pressure... in complete silence.\",\n",
    "        ],\n",
    "    },\n",
    "]\n",
    "\n",
    "# ============================================================\n",
    "# 2. НАСТРОЙКИ\n",
    "# ============================================================\n",
    "speed = 1.0\n",
    "nfe_step = 32\n",
    "SEED = 7\n",
    "slow_factor = 0.85\n",
    "пауза_между_предложениями = 0.2\n",
    "пауза_между_эмоциями = 0.4\n",
    "обрезать_тишину = True\n",
    "порог_тишины = 0.015\n",
    "запас_сек = 0.05\n",
    "\n",
    "# ============================================================\n",
    "# 3. ГЕНЕРАЦИЯ\n",
    "# ============================================================\n",
    "import os, shutil, subprocess, re\n",
    "import numpy as np\n",
    "import torch\n",
    "import torchaudio\n",
    "from IPython.display import Audio, display\n",
    "from difflib import SequenceMatcher\n",
    "import whisper\n",
    "\n",
    "DRIVE_SOUND_DIR = \"/content/drive/MyDrive/sound/output\"\n",
    "LOCAL_WORK_DIR = \"/content/voices_work\"\n",
    "\n",
    "def trim_silence(audio, sr, threshold=0.015, pad_sec=0.05):\n",
    "    if audio.ndim > 1:\n",
    "        audio = audio.mean(axis=1)\n",
    "    mask = np.abs(audio) > threshold\n",
    "    if not mask.any():\n",
    "        return audio\n",
    "    first = int(np.argmax(mask))\n",
    "    last = int(len(mask) - np.argmax(mask[::-1]))\n",
    "    pad = int(sr * pad_sec)\n",
    "    return audio[max(0, first - pad):min(len(audio), last + pad)]\n",
    "\n",
    "def normalize_text(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'\\d+', '', text)\n",
    "    text = re.sub(r'[^\\w\\s]', '', text)\n",
    "    text = re.sub(r'\\s+', ' ', text)\n",
    "    return text.strip()\n",
    "\n",
    "def compare_texts(expected, recognized):\n",
    "    exp_norm = normalize_text(expected)\n",
    "    rec_norm = normalize_text(recognized)\n",
    "    similarity = SequenceMatcher(None, exp_norm, rec_norm).ratio() * 100\n",
    "    exp_words = set(exp_norm.split())\n",
    "    rec_words = set(rec_norm.split())\n",
    "    return {\n",
    "        \"similarity\": similarity,\n",
    "        \"total_words\": len(exp_words),\n",
    "        \"common\": len(exp_words & rec_words),\n",
    "        \"missing\": exp_words - rec_words,\n",
    "        \"extra\": rec_words - exp_words,\n",
    "    }\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(f\"ЭМОЦИЙ: {len(emotion_blocks)}\")\n",
    "print(f\"SEED: {SEED} | speed: {speed} | atempo: {slow_factor}\")\n",
    "print(f\"ANGRY разбит на {len(emotion_blocks[2]['sentences'])} части\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# --- Генерация ---\n",
    "all_chunks = []\n",
    "emotion_boundaries = []\n",
    "target_sr = None\n",
    "\n",
    "for block_idx, block in enumerate(emotion_blocks):\n",
    "    emotion = block[\"emotion\"]\n",
    "    sentences = block[\"sentences\"]\n",
    "\n",
    "    ref_fname, ref_text = EMOTION_REFS[emotion]\n",
    "    ref_path = os.path.join(LOCAL_WORK_DIR, ref_fname)\n",
    "\n",
    "    if not os.path.exists(ref_path):\n",
    "        src = os.path.join(DRIVE_SOUND_DIR, ref_fname)\n",
    "        if os.path.exists(src):\n",
    "            shutil.copy(src, ref_path)\n",
    "        else:\n",
    "            raise FileNotFoundError(f\"Референс не найден: {src}\")\n",
    "\n",
    "    print(f\"\\n{'=' * 60}\")\n",
    "    print(f\"БЛОК {block_idx + 1}/{len(emotion_blocks)}: {emotion.upper()}\")\n",
    "    print(f\"{'=' * 60}\")\n",
    "\n",
    "    for i, sentence in enumerate(sentences):\n",
    "        print(f\"\\n  [{i+1}/{len(sentences)}] \\\"{sentence[:75]}{'...' if len(sentence) > 75 else ''}\\\"\")\n",
    "\n",
    "        try:\n",
    "            wav, sr, _ = f5tts.infer(\n",
    "                ref_file=ref_path,\n",
    "                ref_text=ref_text,\n",
    "                gen_text=sentence,\n",
    "                speed=speed,\n",
    "                nfe_step=nfe_step,\n",
    "                seed=SEED,\n",
    "            )\n",
    "\n",
    "            if not isinstance(wav, torch.Tensor):\n",
    "                wav = torch.from_numpy(wav) if hasattr(wav, \"numpy\") else torch.tensor(wav)\n",
    "            wav_np = wav.float().flatten().numpy()\n",
    "\n",
    "            if обрезать_тишину:\n",
    "                before = len(wav_np) / sr\n",
    "                wav_np = trim_silence(wav_np, sr, threshold=порог_тишины, pad_sec=запас_сек)\n",
    "                after = len(wav_np) / sr\n",
    "                print(f\"      ✂️  {before:.2f}s → {after:.2f}s\")\n",
    "\n",
    "            wav = torch.from_numpy(wav_np).float()\n",
    "\n",
    "            if target_sr is None:\n",
    "                target_sr = sr\n",
    "            elif sr != target_sr:\n",
    "                wav = torchaudio.functional.resample(wav, sr, target_sr)\n",
    "\n",
    "            all_chunks.append(wav)\n",
    "            print(f\"      ✅ {len(wav)/target_sr:.2f} сек\")\n",
    "\n",
    "        except Exception as e:\n",
    "            print(f\"      ❌ Ошибка: {e}\")\n",
    "\n",
    "    emotion_boundaries.append(len(all_chunks) - 1)\n",
    "\n",
    "# --- Склейка ---\n",
    "print(f\"\\n{'=' * 60}\")\n",
    "print(\"СКЛЕЙКА\")\n",
    "print(f\"{'=' * 60}\")\n",
    "\n",
    "merged = []\n",
    "for i, c in enumerate(all_chunks):\n",
    "    merged.append(c)\n",
    "\n",
    "    if i < len(all_chunks) - 1:\n",
    "        if i in emotion_boundaries[:-1]:\n",
    "            silence = torch.zeros(int(target_sr * пауза_между_эмоциями))\n",
    "            print(f\"  Пауза между эмоциями после сегмента {i+1}: {пауза_между_эмоциями} сек\")\n",
    "        else:\n",
    "            silence = torch.zeros(int(target_sr * пауза_между_предложениями))\n",
    "        merged.append(silence)\n",
    "\n",
    "final_audio = torch.cat(merged)\n",
    "\n",
    "raw_path = os.path.join(LOCAL_WORK_DIR, \"seed7_raw.wav\")\n",
    "torchaudio.save(raw_path, final_audio.unsqueeze(0), target_sr)\n",
    "print(f\"\\n✅ Сырой: {raw_path} ({len(final_audio)/target_sr:.2f} сек)\")\n",
    "\n",
    "slowed_path = os.path.join(LOCAL_WORK_DIR, \"seed7_slowed.wav\")\n",
    "subprocess.run([\n",
    "    \"ffmpeg\", \"-y\", \"-i\", raw_path,\n",
    "    \"-filter:a\", f\"atempo={slow_factor}\",\n",
    "    slowed_path\n",
    "], capture_output=True)\n",
    "print(f\"✅ Замедленный: {slowed_path}\")\n",
    "\n",
    "# ============================================================\n",
    "# 4. ПРОВЕРКА ЧЕРЕЗ WHISPER\n",
    "# ============================================================\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"🔍 ПРОВЕРКА ЧЕРЕЗ WHISPER\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\"⏳ Загрузка Whisper (small)...\")\n",
    "whisper_model = whisper.load_model(\"small\")\n",
    "print(\"✅ Загружена\\n\")\n",
    "\n",
    "print(\"🎧 Распознавание СЫРОГО файла...\")\n",
    "result_raw = whisper_model.transcribe(raw_path, language=\"en\", fp16=False)\n",
    "recognized_raw = result_raw[\"text\"].strip()\n",
    "\n",
    "print(\"🎧 Распознавание ЗАМЕДЛЕННОГО файла...\")\n",
    "result_slowed = whisper_model.transcribe(slowed_path, language=\"en\", fp16=False)\n",
    "recognized_slowed = result_slowed[\"text\"].strip()\n",
    "\n",
    "expected = \" \".join(\n",
    "    \" \".join(block[\"sentences\"]) for block in emotion_blocks\n",
    ")\n",
    "\n",
    "comparison_raw = compare_texts(expected, recognized_raw)\n",
    "comparison_slowed = compare_texts(expected, recognized_slowed)\n",
    "\n",
    "# ============================================================\n",
    "# 5. ВЫВОД\n",
    "# ============================================================\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"📊 РЕЗУЛЬТАТ\")\n",
    "print(\"=\" * 60)\n",
    "print(f\"\\n📝 ОЖИДАЕМО ({len(expected.split())} слов)\")\n",
    "\n",
    "print(f\"\\n🎧 СЫРОЙ (speed=1.0, seed={SEED}):\")\n",
    "print(f\"   Схожесть: {comparison_raw['similarity']:.1f}% \"\n",
    "      f\"({comparison_raw['common']}/{comparison_raw['total_words']})\")\n",
    "if comparison_raw['missing']:\n",
    "    print(f\"   ⚠️  Пропущено: {comparison_raw['missing']}\")\n",
    "\n",
    "print(f\"\\n🎧 ЗАМЕДЛЕННЫЙ (atempo={slow_factor}):\")\n",
    "print(f\"   Схожесть: {comparison_slowed['similarity']:.1f}% \"\n",
    "      f\"({comparison_slowed['common']}/{comparison_slowed['total_words']})\")\n",
    "if comparison_slowed['missing']:\n",
    "    print(f\"   ⚠️  Пропущено: {comparison_slowed['missing']}\")\n",
    "\n",
    "print(f\"\\n📄 РАСПОЗНАННЫЙ ТЕКСТ (сырой):\")\n",
    "print(f\"   {recognized_raw}\")\n",
    "\n",
    "# ============================================================\n",
    "# 6. ПЛЕЕРЫ\n",
    "# ============================================================\n",
    "print(\"\\n\" + \"=\" * 60)\n",
    "print(\"🎧 ПРОСЛУШИВАНИЕ\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\"\\n🎧 СЫРОЙ (speed=1.0):\")\n",
    "display(Audio(filename=raw_path))\n",
    "\n",
    "print(f\"\\n🎧 ЗАМЕДЛЕННЫЙ (atempo={slow_factor}):\")\n",
    "display(Audio(filename=slowed_path))\n",
    "\n",
    "# --- Автосохранение на сайт (если нужно) ---\n",
    "# upload_success, upload_msg = upload_to_site(slowed_path)\n",
    "# print(upload_msg)"
   ]
  }
