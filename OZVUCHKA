    "# ============================================================\n",
    "# ЯЧЕЙКА 1: УСТАНОВКА, DRIVE, МОДЕЛЬ, SFTP\n",
    "# ============================================================\n",
    "import os\n",
    "os.environ.pop(\"PYTHONHASHSEED\", None)\n",
    "\n",
    "print(\"⏳ Установка библиотек...\")\n",
    "!pip uninstall -y torchcodec f5-tts nest-asyncio 2>/dev/null\n",
    "!apt-get update -qq && apt-get install -y -qq ffmpeg\n",
    "!pip install -q torch torchaudio --index-url https://download.pytorch.org/whl/cu121\n",
    "!pip install -q torchcodec --index-url https://download.pytorch.org/whl/cpu\n",
    "!pip install -q git+https://github.com/SWivid/F5-TTS.git\n",
    "!pip install -q paramiko soundfile openai-whisper\n",
    "\n",
    "import shutil\n",
    "import numpy as np\n",
    "import soundfile as sf\n",
    "import torch\n",
    "import torchaudio\n",
    "from f5_tts.api import F5TTS\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(f\"Устройство: {device} | CUDA доступна: {torch.cuda.is_available()}\")\n",
    "\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "DRIVE_SOUND_DIR = \"/content/drive/MyDrive/sound/output\"\n",
    "PADDED_DIR = \"/content/drive/MyDrive/sound/output_padded\"\n",
    "LOCAL_WORK_DIR = \"/content/voices_work\"\n",
    "\n",
    "os.makedirs(LOCAL_WORK_DIR, exist_ok=True)\n",
    "os.makedirs(PADDED_DIR, exist_ok=True)\n",
    "\n",
    "# --- SFTP ---\n",
    "import paramiko\n",
    "from google.colab import userdata\n",
    "\n",
    "SFTP_HOST = \"185.182.65.58\"\n",
    "SFTP_PORT = 22\n",
    "SFTP_USER = \"root\"\n",
    "SFTP_PASS = userdata.get('SFTP_PASS')\n",
    "REMOTE_PATH = \"/var/www/lepka-iz-plastilina.ru/public_html/tts/alec/\"\n",
    "PUBLIC_URL = \"https://lepka-iz-plastilina.ru/tts/alec/\"\n",
    "\n",
    "def upload_to_site(local_file):\n",
    "    try:\n",
    "        transport = paramiko.Transport((SFTP_HOST, SFTP_PORT))\n",
    "        transport.connect(username=SFTP_USER, password=SFTP_PASS)\n",
    "        sftp = paramiko.SFTPClient.from_transport(transport)\n",
    "        remote_file = os.path.join(REMOTE_PATH, os.path.basename(local_file))\n",
    "        sftp.put(local_file, remote_file)\n",
    "        sftp.close()\n",
    "        transport.close()\n",
    "        return True, f\"{PUBLIC_URL}{os.path.basename(local_file)}\"\n",
    "    except Exception as e:\n",
    "        return False, f\"Upload error: {e}\"\n",
    "\n",
    "print(\"✅ SFTP настроен\")\n",
    "\n",
    "# ============================================================\n",
    "# РЕФЕРЕНСЫ: 6 ЭМОЦИЙ\n",
    "# ============================================================\n",
    "EMOTION_REFS = {\n",
    "    \"neutral\": (\n",
    "        \"en_1-Neutral.wav\",\n",
    "        \"Суперзвезда НХЛ, один из лучших вратарей в истории мирового хоккея.\"\n",
    "    ),\n",
    "    \"hype\": (\n",
    "        \"en_2-High-Energy.wav\",\n",
    "        \"Ну еще, еще продержись. Ох, как жарко на этом снегу писал поэт.\"\n",
    "    ),\n",
    "    \"angry\": (\n",
    "        \"en_3-Frustration.wav\",\n",
    "        \"Почему не показываем на матче спидвей?\"\n",
    "    ),\n",
    "    \"irony\": (\n",
    "        \"en_4-Playful.wav\",\n",
    "        \"Она мне нравилась жутко. Она школу закончила такая, прям как тростиночка.\"\n",
    "    ),\n",
    "    \"drama\": (\n",
    "        \"en_5-Dramatic.wav\",\n",
    "        \"Я говорю, ребята, если я сейчас\"\n",
    "    ),\n",
    "    \"shock\": (\n",
    "        \"en_6-Shock.wav\",\n",
    "        \"У вас лыжи деревянные в 21 веке, она встала и убежала. Мне ее даже жалко стало.\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "# ============================================================\n",
    "# КОПИРУЕМ И ДОБАВЛЯЕМ ТИШИНУ В КОНЕЦ\n",
    "# ============================================================\n",
    "SILENCE_END_SEC = 1.0\n",
    "SILENCE_START_SEC = 0.2\n",
    "\n",
    "print(\"\\nКопирование и подготовка референсов...\")\n",
    "missing = []\n",
    "\n",
    "for emo, (fname, ref_text) in EMOTION_REFS.items():\n",
    "    src = os.path.join(DRIVE_SOUND_DIR, fname)\n",
    "    dst_drive = os.path.join(PADDED_DIR, fname)\n",
    "    dst_local = os.path.join(LOCAL_WORK_DIR, fname)\n",
    "\n",
    "    if not os.path.exists(src):\n",
    "        print(f\"  ❌ НЕ НАЙДЕН: {src}\")\n",
    "        missing.append(fname)\n",
    "        continue\n",
    "\n",
    "    audio, sr = sf.read(src)\n",
    "    if audio.ndim > 1:\n",
    "        audio = audio.mean(axis=1)\n",
    "\n",
    "    silence_start = np.zeros(int(sr * SILENCE_START_SEC))\n",
    "    silence_end = np.zeros(int(sr * SILENCE_END_SEC))\n",
    "    audio_new = np.concatenate([silence_start, audio, silence_end])\n",
    "\n",
    "    sf.write(dst_drive, audio_new, sr)\n",
    "    sf.write(dst_local, audio_new, sr)\n",
    "\n",
    "    orig_dur = len(audio) / sr\n",
    "    new_dur = len(audio_new) / sr\n",
    "    print(f\"  ✅ {emo:10s} ← {fname} ({orig_dur:.2f}s → {new_dur:.2f}s)\")\n",
    "\n",
    "if missing:\n",
    "    raise FileNotFoundError(f\"Не хватает файлов в {DRIVE_SOUND_DIR}: {missing}\")\n",
    "\n",
    "# ============================================================\n",
    "# ЗАГРУЗКА МОДЕЛИ\n",
    "# ============================================================\n",
    "print(\"\\nЗагрузка модели F5-TTS в память GPU...\")\n",
    "f5tts = F5TTS(model=\"F5TTS_v1_Base\", device=device)\n",
    "print(\"✅ Всё готово! Теперь запускайте Ячейку 2.\")"
   ]
